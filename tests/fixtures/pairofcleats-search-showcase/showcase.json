      "expectAny": [
        { "file": "tests/fixtures/languages/src/javascript_advanced.js", "name": "Widget.update" }
      ]
    },
    {
      "id": "output-json-compact-score-breakdown",
      "title": "Compact JSON output",
      "stability": "stable",
