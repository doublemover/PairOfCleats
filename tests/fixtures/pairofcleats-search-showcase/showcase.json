      "expectAny": [
        { "file": "tests/fixtures/languages/src/javascript_advanced.js", "name": "Widget.iter" }
      ]
    },
    {
      "id": "filter-returns-javascript-update",
      "title": "Returns filter",
      "stability": "stable",
      "category": "filter",
      "mode": "code",
      "query": "update",
      "args": ["--path", "tests/fixtures/languages/src/javascript_advanced.js", "--returns"],
