        { "file": "src/retrieval/cli-args.js" }
      ]
    },
    {
      "id": "filter-extends-base-widget",
      "title": "Inheritance filter",
      "stability": "stable",
      "category": "filter",
      "mode": "code",
      "query": "Widget",
      "args": ["--path", "tests/fixtures/languages/src/typescript_advanced.ts", "--extends", "BaseWidget"],
      "why": "Stable `extends` example using a checked-in TypeScript fixture.",
      "expectAny": [
        { "file": "tests/fixtures/languages/src/typescript_advanced.ts", "name": "Widget" }
      ]
    },
    {
      "id": "filter-async-javascript-load",
      "title": "Async filter",
      "stability": "stable",
      "category": "filter",
      "mode": "code",
      "query": "load",
      "args": ["--path", "tests/fixtures/languages/src/javascript_advanced.js", "--async"],
