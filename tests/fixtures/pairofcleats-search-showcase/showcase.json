      ]
    },
    {
      "id": "output-stats-explain-score-breakdown",
      "title": "Stats and explain output",
      "stability": "stable",
      "category": "output",
      "mode": "code",
      "query": "scoreBreakdown",
      "args": ["--path", "src/retrieval", "--json", "--stats", "--explain", "--top", "3"],
      "why": "Best default search for inspecting pipeline stats and score explanations together.",
