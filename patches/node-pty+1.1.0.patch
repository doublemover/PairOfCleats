+        ++count;
+        more = Process32NextW(invalidNextHandle ? INVALID_HANDLE_VALUE : snapshot, &entry);
+      }
+      if (failureCode == ERROR_SUCCESS) failureCode = GetLastError();
+    } catch (const std::exception&) {
+      failureCode = ERROR_NOT_ENOUGH_MEMORY;
+    }
+    closed = CloseHandle(snapshot) != FALSE;
+    if (!closed) cleanupCode = GetLastError();
+  }
+  if (failureCode != ERROR_NO_MORE_FILES || !closed) {
+    Napi::Error error = Napi::Error::New(env, "Incomplete native Windows process snapshot");
+    error.Value().Set("code", "ERR_WINDOWS_PROCESS_SNAPSHOT_NATIVE");
+    error.Value().Set("win32Error", Napi::Number::New(env, failureCode));
+    error.Value().Set("cleanupWin32Error", Napi::Number::New(env, cleanupCode));
+    error.Value().Set("resourcesClosed", Napi::Boolean::New(env, closed));
+    throw error;
+  }
+  Napi::Object result = Napi::Object::New(env);
+  result.Set("rows", Napi::String::New(env, rows));
