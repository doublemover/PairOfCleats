+    throw Napi::TypeError::New(env, "Usage: getProcessSnapshot([invalidNextHandle])");
+  }
+  const bool invalidNextHandle = info.Length() == 1 && info[0].As<Napi::Boolean>().Value();
+  HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+  DWORD failureCode = snapshot == INVALID_HANDLE_VALUE ? GetLastError() : ERROR_SUCCESS;
+  DWORD cleanupCode = ERROR_SUCCESS;
+  bool closed = snapshot == INVALID_HANDLE_VALUE;
+  std::string rows;
+  uint32_t count = 0;
+  if (snapshot != INVALID_HANDLE_VALUE) {
+    try {
+      PROCESSENTRY32W entry = {};
+      entry.dwSize = sizeof(entry);
+      BOOL more = Process32FirstW(snapshot, &entry);
+      while (more) {
+        if (count == 1048576) { failureCode = ERROR_INSUFFICIENT_BUFFER; break; }
+        rows.append(std::to_string(entry.th32ProcessID)).append(" ")
