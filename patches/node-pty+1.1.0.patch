-process.exit(0);
+
+// The 1.1.0 tarball omits executable bits from its macOS spawn helpers.
+if (process.platform === 'darwin') {
+  const spawnHelper = path.join(PREBUILD_DIR, 'spawn-helper');
+  const helperStat = fs.lstatSync(spawnHelper);
+  if (!helperStat.isFile()) {
+    throw new Error('node-pty spawn-helper must be a regular file');
+  }
+  fs.chmodSync(spawnHelper, helperStat.mode | 0o111);
+}
+
+process.exit(0); // Prebuilt artifacts, including the helper, are ready.
