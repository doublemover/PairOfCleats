{
  "name": "pairofcleats",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "pairofcleats": "bin/pairofcleats.js",
    "pairofcleats-tui": "bin/pairofcleats-tui.js"
  },
  "description": "Hybrid semantic indexer and search utility for codebases",
  "scripts": {
    "bootstrap": "npm install --ignore-scripts && node tools/setup/apply-patches.js && node tools/setup/rebuild-native.js",
    "bootstrap:ci": "npm ci --ignore-scripts && node tools/setup/apply-patches.js && node tools/setup/rebuild-native.js",
    "test": "node tests/run.js --lane ci-lite",
    "test:ci-lite": "node tests/run.js --lane ci-lite",
    "test:ci": "node tests/run.js --lane ci",
    "test:ci-long": "node tests/run.js --lane ci-long",
    "test:lane-audit": "node tools/testing/lane-audit.js",
    "test:refresh-governance": "node tools/testing/refresh-governance.js",
    "test:services": "node tests/run.js --lane services",
    "test:api": "node tests/run.js --lane api",
    "test:storage": "node tests/run.js --lane storage",
    "test:perf": "node tests/run.js --lane perf",
    "audit:duplicates": "jscpd --config .jscpd.json --absolute src bin tools tests extensions sublime",
    "verify": "node tools/ci/run-suite.js --mode ci",
    "verify:production": "node tools/testing/refresh-governance.js && node tests/ci/markdown-link-check.test.js && node tests/tooling/docs/contract-matrix.test.js && node tests/tooling/script-coverage/harness.test.js && node tools/release/check.js --dry-run",
    "config:budget": "node tools/config/inventory.js --check",
    "env:check": "node tools/ci/check-env-usage.js",
    "release:verify": "node tools/release/check.js --report release_check_report.json --manifest release-manifest.json",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "postinstall": "node tools/setup/postinstall.js"
  },
