{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "usr-release-readiness-scorecard-report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "generatedAt",
    "producerId",
    "runId",
    "lane",
    "buildId",
    "status",
    "scope",
    "summary",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "artifactId": {
      "type": "string",
      "const": "usr-release-readiness-scorecard"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producerId": {
      "type": "string"
    },
    "producerVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "runId": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "buildId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "error",
        "partial"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeType",
        "scopeId"
      ],
      "properties": {
        "scopeType": {
          "type": "string",
          "enum": [
            "global",
            "lane",
            "language",
            "framework"
          ]
        },
        "scopeId": {
          "type": "string"
        }
      }
    },
    "blockingFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "advisoryFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked",
        "blockerCount",
        "errorCount",
        "warningCount",
        "readiness",
        "conformanceByLevel"
      ],
      "properties": {
        "blocked": {
          "type": "boolean"
        },
        "blockerCount": {
          "type": "integer",
          "minimum": 0
        },
        "errorCount": {
          "type": "integer",
          "minimum": 0
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "testRolloutBlocked",
            "deepConformanceBlocked",
            "frameworkConformanceBlocked"
          ],
          "properties": {
            "testRolloutBlocked": {
              "type": "boolean"
            },
            "deepConformanceBlocked": {
              "type": "boolean"
            },
            "frameworkConformanceBlocked": {
              "type": "boolean"
            }
          }
        },
        "conformanceByLevel": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "requiredProfileCount",
              "failingRequiredProfileCount",
              "errorCount",
              "warningCount",
              "pass"
            ],
            "properties": {
              "level": {
                "type": "string"
              },
              "requiredProfileCount": {
                "type": "integer",
                "minimum": 0
              },
              "failingRequiredProfileCount": {
                "type": "integer",
                "minimum": 0
              },
              "errorCount": {
                "type": "integer",
                "minimum": 0
              },
              "warningCount": {
                "type": "integer",
                "minimum": 0
              },
              "pass": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rowType",
              "id",
              "pass",
              "blocked"
            ],
            "properties": {
              "rowType": {
                "type": "string",
                "const": "readiness-dimension"
              },
              "id": {
                "type": "string",
                "enum": [
                  "test-rollout",
                  "deep-conformance",
                  "framework-conformance"
                ]
              },
              "pass": {
                "type": "boolean"
              },
              "blocked": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rowType",
              "id",
              "pass",
              "requiredProfileCount",
              "failingRequiredProfileCount",
              "errorCount",
              "warningCount"
            ],
            "properties": {
              "rowType": {
                "type": "string",
                "const": "conformance-level"
              },
              "id": {
                "type": "string"
              },
              "pass": {
                "type": "boolean"
              },
              "requiredProfileCount": {
                "type": "integer",
                "minimum": 0
              },
              "failingRequiredProfileCount": {
                "type": "integer",
                "minimum": 0
              },
              "errorCount": {
                "type": "integer",
                "minimum": 0
              },
              "warningCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    }
  },
  "$id": "usr/usr-release-readiness-scorecard.schema.json"
}
