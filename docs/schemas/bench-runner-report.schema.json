{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pairofcleats://schemas/bench-runner-report.schema.json",
  "title": "PairOfCleats Bench Runner Report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "runner", "summary", "results"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "generatedAt": { "type": "string" },
    "runner": {
      "type": "object",
      "required": ["cwd", "platform", "release", "arch", "node", "args"],
      "properties": {
        "cwd": { "type": "string" },
        "platform": { "type": "string" },
        "release": { "type": "string" },
        "arch": { "type": "string" },
        "node": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["ok", "error", "timeout", "skipped", "regressionSignals"],
      "properties": {
        "ok": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "regressionSignals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "script", "metric", "deltaMs"],
            "properties": {
              "id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
              "script": { "type": "string" },
              "metric": { "type": "string" },
              "deltaMs": { "type": "number" }
            },
            "additionalProperties": true
          }
        },
        "artifactStallDurationMs": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["count", "p95", "p99", "max"],
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "p95": { "type": "number", "minimum": 0 },
                "p99": { "type": "number", "minimum": 0 },
                "max": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": true
            }
          ]
        },
        "stageOverlap": {
          "type": "object",
          "required": ["count", "avgPct", "p50Pct", "p95Pct", "maxPct", "rows"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "avgPct": { "type": "number", "minimum": 0, "maximum": 100 },
            "p50Pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "p95Pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "maxPct": { "type": "number", "minimum": 0, "maximum": 100 },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["script", "totalMs", "overlapMs", "overlapPct"],
                "properties": {
                  "script": { "type": "string" },
                  "totalMs": { "type": "number", "minimum": 0 },
                  "parseMs": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
                  "inferMs": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
                  "writeMs": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
                  "overlapMs": { "type": "number", "minimum": 0 },
                  "overlapPct": { "type": "number", "minimum": 0, "maximum": 100 }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "perCoreUtilization": {
          "type": "object",
          "required": ["sampleCount", "avgPct", "minPct", "maxPct", "p50Pct", "p95Pct", "timeline", "scope", "hardwareCpuMeasurement", "observedCount", "validCount", "unavailableCount", "omittedCount", "byScope"],
          "properties": {
            "sampleCount": { "type": "integer", "minimum": 0 },
            "avgPct": { "$ref": "#/$defs/optionalPercent" },
            "minPct": { "$ref": "#/$defs/optionalPercent" },
            "maxPct": { "$ref": "#/$defs/optionalPercent" },
            "p50Pct": { "$ref": "#/$defs/optionalPercent" },
            "p95Pct": { "$ref": "#/$defs/optionalPercent" },
            "scope": { "enum": ["producer-declared-utilization", "scheduler-token-occupancy", "mixed", "unavailable"] },
            "hardwareCpuMeasurement": { "const": false },
            "observedCount": { "type": "integer", "minimum": 0 },
            "validCount": { "type": "integer", "minimum": 0 },
            "unavailableCount": { "type": "integer", "minimum": 0 },
            "omittedCount": { "type": "integer", "minimum": 0 },
            "byScope": {
              "type": "object",
              "required": ["producer-declared-utilization", "scheduler-token-occupancy"],
              "properties": {
                "producer-declared-utilization": { "$ref": "#/$defs/utilizationStats" },
                "scheduler-token-occupancy": { "$ref": "#/$defs/utilizationStats" }
              },
              "additionalProperties": false
            },
            "timeline": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "object",
                "required": ["script", "sample", "utilizationPct", "source", "sourceUnit", "scope", "rawValue"],
                "properties": {
                  "script": { "type": "string" },
                  "sample": { "type": "integer", "minimum": 0 },
                  "atMs": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
                  "utilizationPct": { "type": "number", "minimum": 0, "maximum": 100 },
                  "source": { "enum": ["utilizationPct", "overallPct", "utilization.overallPct", "utilization.overall", "cpuUsed/cpuTotal", "tokensUsed.cpu/tokensTotal.cpu", "used.cpu/limits.cpu"] },
                  "sourceUnit": { "enum": ["percent", "ratio", "token-ratio"] },
                  "scope": { "enum": ["producer-declared-utilization", "scheduler-token-occupancy"] },
                  "rawValue": { "type": "number", "minimum": 0, "maximum": 100 },
                  "used": { "type": "number", "minimum": 0 },
                  "total": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "criticalPath": {
          "type": "object",
          "required": ["scripts", "artifacts", "reconstructedTail"],
          "properties": {
            "scripts": { "type": "array" },
            "artifacts": { "type": "array" },
            "reconstructedTail": { "type": "array" }
          },
          "additionalProperties": true
        },
        "triageHints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "script",
          "absScript",
          "args",
          "expect",
          "ok",
          "status",
          "processOk",
          "signal",
          "processFailure",
          "skipped",
          "skipReason",
          "parsedOk",
          "errors",
          "timedOut",
          "exitCode",
          "durationMs",
          "parsed",
          "json",
          "stdout",
          "stderr"
        ],
        "properties": {
          "id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "script": { "type": "string" },
          "absScript": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "expect": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
          "ok": { "type": "boolean" },
          "status": { "enum": ["ok", "error", "timeout", "skipped"] },
          "processOk": { "type": "boolean" },
          "signal": { "type": ["string", "null"] },
          "processFailure": { "type": ["string", "null"] },
          "skipped": { "type": "boolean" },
          "skipReason": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "parsedOk": { "type": "boolean" },
          "errors": { "type": "array", "items": { "type": "string" } },
          "timedOut": { "type": "boolean" },
          "exitCode": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "durationMs": { "type": "number", "minimum": 0 },
          "parsed": {
            "type": "object",
            "required": ["baseline", "current", "delta"],
            "properties": {
              "baseline": { "$ref": "#/$defs/benchLine" },
              "current": { "$ref": "#/$defs/benchLine" },
              "delta": { "$ref": "#/$defs/benchLine" }
            },
            "additionalProperties": false
          },
          "json": {},
          "stdout": { "type": "string" },
          "stderr": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "ok" } } },
            "then": { "properties": { "ok": { "const": true }, "skipped": { "const": false }, "processOk": { "const": true } } },
            "else": { "properties": { "ok": { "const": false } } }
          },
          {
            "if": { "properties": { "status": { "const": "skipped" } } },
            "then": { "properties": { "skipped": { "const": true }, "processOk": { "const": true } } },
            "else": { "properties": { "skipped": { "const": false } } }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "optionalPercent": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
    "utilizationStats": {
      "type": "object",
      "required": ["sampleCount", "avgPct", "minPct", "maxPct", "p50Pct", "p95Pct"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 0, "maximum": 2048 },
        "avgPct": { "$ref": "#/$defs/optionalPercent" },
        "minPct": { "$ref": "#/$defs/optionalPercent" },
        "maxPct": { "$ref": "#/$defs/optionalPercent" },
        "p50Pct": { "$ref": "#/$defs/optionalPercent" },
        "p95Pct": { "$ref": "#/$defs/optionalPercent" }
      },
      "additionalProperties": false
    },
    "benchLine": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["line", "metrics"],
          "properties": {
            "line": { "type": "string" },
            "metrics": { "type": "object" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": true
}
